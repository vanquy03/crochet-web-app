# Sao chép thành .env nếu cần thay cấu hình. Không commit .env.
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
DATA_DIR=./data
# Chỉ bật khi ứng dụng nằm sau đúng một reverse proxy đáng tin cậy.
TRUST_PROXY=0

# TẠM THỜI cho Render Free không có Shell. Không điền mật khẩu thật trong file này.
# Chỉ tạo admin chưa tồn tại, không đổi mật khẩu admin đã có; không chạy seed.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
